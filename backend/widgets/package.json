{
  "name": "@interakt/widgets",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Drop-in search and chat widgets for Interakt. Built as a self-contained IIFE bundle that exposes window.SearchDropinUI and window.ChatDropinUI.",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25.0.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "dompurify": "^3.2.3",
    "marked": "^18.2.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.5",
    "@testing-library/preact": "^3.2.6",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^8.0.10",
    "vitest": "^5.1.0"
  }
}
